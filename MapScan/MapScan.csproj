<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>MapScan</AssemblyName>
    <RootNamespace>Poe2Map</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Cikis etiketleri icin istege bagli veri (bkz. data/README.md). Depoda YOK:
      baskasinin (MordWraith/Radar) verisini burada dagitmiyoruz. Dosya data/ altina
      konursa cikislar gercek adiyla etiketlenir; yoksa jenerik etiket kullanilir.
      Bu yuzden kopyalama Exists ile korunuyor - dosyasiz derleme de gecsin.
    -->
    <None Include="..\data\important_tgt_files.txt" Link="important_tgt_files.txt"
          Condition="Exists('..\data\important_tgt_files.txt')"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
